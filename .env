PORT=3010
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL — Shared container from infrastructure/docker-compose.yml
# Logical database: pomaiwhiteboard (separate from workspace_db, auth_db, etc.)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/pomaiwhiteboard

# ─────────────────────────────────────────────────────────────────────────────
# Redis — Shared container from infrastructure/docker-compose.yml
# Used for: temporary (guest) workspace storage with 24h TTL
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://pomaieco_redis:6379

# ─────────────────────────────────────────────────────────────────────────────
# Kafka — Shared container from infrastructure/docker-compose.yml
# Internal Docker network address (kafka:29092, NOT localhost:9092)
# Matches KAFKA_ADVERTISED_LISTENERS in infrastructure/docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=kafka:29092

# Topic the realtime-hub PRODUCES to (backend CONSUMES from this)
# Matches KAFKA_OUTGOING_TOPIC in infrastructure/realtime-hub/internal/config/config.go
KAFKA_CONSUMER_TOPIC=realtime-outgoing-events

# Topic the realtime-hub CONSUMES from (backend PRODUCES to this)
# Matches KAFKA_INCOMING_TOPIC in infrastructure/realtime-hub/internal/config/config.go
KAFKA_PRODUCER_TOPIC=realtime-incoming-events

# Unique consumer group ID for this service
KAFKA_CONSUMER_GROUP=pomaiwhiteboard-state-manager

# ─────────────────────────────────────────────────────────────────────────────
# MinIO — Shared container from infrastructure/docker-compose.yml
# Used for: .excalidraw file persistence (scene snapshots / exports)
# Internal: minio:9000  |  External console: localhost:9003
# The whiteboard service uses a DEDICATED bucket separate from data-hub's 'lakehouse'
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET=pomaiwhiteboard
MINIO_USE_SSL=false

# ─────────────────────────────────────────────────────────────────────────────
# JWT — Must match core/workspace/backend JWT_ACCESS_SECRET
# Used by Kong to validate the JWT before forwarding X-User-Id header
# to the /workspaces/:id/claim endpoint
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) Environment Variables (Consolidated)
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_WHITEBOARD_API_URL=/api/v1/whiteboard
VITE_APP_ENABLE_TRACKING=false
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
VITE_APP_ENABLE_ESLINT=false

PORT=3010
NODE_ENV=development

# Shared Postgres container from infrastructure/docker-compose.yml
DATABASE_URL=postgres://postgres:postgrespassword@postgres:5432/pomaiwhiteboard

# Shared Redis container from infrastructure/docker-compose.yml
REDIS_URL=redis://pomaieco_redis:6379

# Kafka broker — internal Docker network address (not localhost:9092)
KAFKA_BROKERS=kafka:29092

# Topic the realtime-hub PRODUCES to (backend CONSUMES from this)
# Matches KAFKA_OUTGOING_TOPIC in infrastructure/realtime-hub/internal/config/config.go
KAFKA_CONSUMER_TOPIC=realtime-outgoing-events

# Topic the realtime-hub CONSUMES from (backend PRODUCES to this)
# Matches KAFKA_INCOMING_TOPIC in infrastructure/realtime-hub/internal/config/config.go
KAFKA_PRODUCER_TOPIC=realtime-incoming-events

# Consumer group ID — unique to this service
KAFKA_CONSUMER_GROUP=pomaiwhiteboard-state-manager

# JWT secret — must match core/workspace/backend JWT_ACCESS_SECRET
# Used by Kong JWT plugin, not parsed here directly
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
